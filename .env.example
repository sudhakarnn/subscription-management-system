# ==============================================================================
# Brightloop SaaS - Environment Configuration Template
# Copy this file to .env before starting the services locally
# ==============================================================================

# Application Settings
PROJECT_NAME="Brightloop SaaS"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Currency Configuration
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL="₹"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=brightloop_admin
POSTGRES_PASSWORD=brightloop_secret
POSTGRES_DB=brightloop_db
DATABASE_URL=postgresql://brightloop_admin:brightloop_secret@localhost:5432/brightloop_db

# Security & Authentication (JWT)
# Generate a strong 32-byte secret key for production: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_32_byte_secure_hex_key_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=15

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Brightloop"
VITE_DEFAULT_CURRENCY=INR
VITE_CURRENCY_SYMBOL="₹"
